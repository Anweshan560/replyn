# Copy this file to .env and fill in the two required values.

# Required: the test account
TEST_USERNAME=
TEST_PASSWORD=

# Optional: defaults point at the beta environment
BASE_URL=https://beta.replyn.dev
API_URL=https://api.replyn.dev
CLERK_URL=https://expert-albacore-78.clerk.accounts.dev
TENANT_ID=replyn
# The workspace (by name) every test runs in; setup switches to it after logging in
TEST_WORKSPACE=Testing
# Slowest acceptable API response, in milliseconds
API_RESPONSE_BUDGET_MS=3000

# Optional: set to true to run without a visible browser window (CI is always headless)
HEADLESS=false

# Optional: write failed tests to a Google Sheet as test cases (see README, "Failed tests sheet")
# The id is the long part of the sheet's link: docs.google.com/spreadsheets/d/<id>/edit
FAILED_TESTS_SHEET_ID=
# Path to the Google service-account key you downloaded (keep it in secrets/, which git ignores)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=secrets/google-service-account.json
# Set to true to write the rows to test-results/failed-tests-sheet.json instead of the sheet
FAILED_TESTS_SHEET_DRY_RUN=false

# Daily Instagram message (see README, "Daily Instagram message"). Only `npm run instagram:login` needs
# the username and password; CI uses the saved session instead.
IG_SENDER_USERNAME=
IG_SENDER_PASSWORD=
IG_RECEIVER_HANDLE=
